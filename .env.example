# Copy to .env (git-ignored) or export in your shell. All are OPTIONAL.
# Polite-pool contact email for OpenAlex (free, no key needed).
OPENALEX_MAILTO=
# Free Semantic Scholar API key (optional; raises rate limits).
SEMANTIC_SCHOLAR_API_KEY=
# Optional Claude API key. Usage is billed by Anthropic per token to YOUR API account,
# separately from Claude Code cloud-session credits or any Claude subscription.
ANTHROPIC_API_KEY=
# Optional overrides
PAPER_ANALYST_DB=papers.db
PAPER_ANALYST_CLAUDE_MODEL=claude-opus-5-5
# Set to 1 to force offline mode (mocked API responses) for every command.
PAPER_ANALYST_OFFLINE=0
